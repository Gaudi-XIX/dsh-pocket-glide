# Local-only install settings for this plugin (F:\defws\dsh-pocket).
#
# auto-install-peers=false keeps this standalone plugin's `pnpm install` from
# pulling a second copy of the whole @deepseek-ai/dsh runtime into the plugin
# directory. The host provides dsh at load time; the plugin convention here
# declares NO peerDependencies on @deepseek-ai/dsh and gates compatibility with
# `dsh.engines.dsh` inside package.json instead — see the `dsh-plugin-dev`
# reference (plugin manifest) for that convention. The install that actually
# matters is the profile's own `pnpm install` over a `link:` dependency; this
# file only governs installs run inside this directory.

auto-install-peers=false
