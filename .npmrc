# Local-only install settings for F:\defws\dsh-phone-native.
#
# auto-install-peers=false keeps this standalone plugin's `pnpm install` from
# pulling a second copy of the whole @deepseek-ai/dsh runtime into the plugin
# directory. The host provides dsh at load time; the official plugin convention
# (see F:\defws\dsh-remote-web-ui-fork\package.json) declares NO
# peerDependencies on @deepseek-ai/dsh and gates compatibility with
# `dsh.engines.dsh` inside package.json instead.

auto-install-peers=false
