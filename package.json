{
  "name": "dsh-pocket-glide",
  "version": "0.4.54",
  "description": "Pocket DSH Glide — a deliberately small, touch-first phone plugin for a running DSH host: pair by QR/PIN, read sessions and history, send messages, stream replies, approve tool permissions. Runs inside the host process, not as a desktop mirror: no build step, one runtime dependency, LAN listener plus an optional Cloudflare quick tunnel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:real-webserver": "node test-real-webserver.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "pngjs": "^5.0.0"
  },
  "files": [
    "lib/**/*.js",
    "client/**/*.js",
    "test",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaudi-XIX/dsh-pocket-glide.git"
  },
  "author": "Gaudi-XIX <49468224+Gaudi-XIX@users.noreply.github.com>",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pocket",
    "phone",
    "mobile",
    "touch",
    "remote",
    "bridge",
    "cloudflare-tunnel"
  ],
  "homepage": "https://github.com/Gaudi-XIX/dsh-pocket-glide#readme",
  "bugs": {
    "url": "https://github.com/Gaudi-XIX/dsh-pocket-glide/issues"
  }
}
