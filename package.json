{
  "name": "dsh-pocket-glide",
  "version": "0.4.59",
  "description": "Pocket DSH: a zero-build phone plugin for DeepSeek Harness. The host renders narrow screens, no desktop pixels streamed; optimistic sends, steady scroll, on-phone approvals, LAN or outbound tunnel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:real-webserver": "node test-real-webserver.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "phone-remote",
    "cloudflare-tunnel"
  ],
  "homepage": "https://github.com/Gaudi-XIX/dsh-pocket-glide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaudi-XIX/dsh-pocket-glide.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "pngjs": "^5.0.0"
  },
  "files": [
    "lib/**/*.js",
    "client/**/*.js",
    "test",
    "tools",
    "!tools/dsh-revive.ps1",
    "!tools/clean-auth-cookies.mjs",
    "!tools/**/*.bak*",
    "!tools/install-to-profile.mjs",
    "!tools/sync-step-process.mjs",
    "!tools/probe-updatequeue.mjs",
    "!tools/render-stub.mjs",
    "!tools/render-stub-desktop.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT"
}